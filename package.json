{
  "name": "jscompile",
  "version": "0.3.0",
  "description": "Compile, optimize and compress anything to JS.",
  "homepage": "https://github.com/cjpatoilo/jscompile",
  "repository": "cjpatoilo/jscompile",
  "license": "MIT",
  "author": "CJ Patoilo <cjpatoilo@gmail.com>",
  "bin": "cli.js",
  "main": "index.js",
  "files": [
    "cli.js",
    "index.js"
  ],
  "keywords": [
    "automation",
    "autoprefixer",
    "cli",
    "coffee",
    "coffeescript",
    "compile",
    "compress",
    "ecma",
    "ecmascript",
    "ecmascripts",
    "elm",
    "es2015",
    "es2016",
    "es5",
    "es6",
    "es7",
    "framework",
    "javascript",
    "js",
    "minified",
    "npm",
    "optimize",
    "package",
    "pure",
    "purs",
    "script",
    "scripts",
    "typescript"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-uglify": "^3.0.2"
  },
  "devDependencies": {
    "ava": "^7.0.0",
    "c8": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier-standard": "^16.4.1",
    "proxyquire": "^2.1.3"
  },
  "scripts": {
    "lint": "prettier-standard --check",
    "prepare": "husky",
    "test": "c8 ava"
  },
  "c8": {
    "all": true,
    "include": [
      "index.js",
      "cli.js"
    ],
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100
  },
  "ava": {
    "files": [
      "index.test.js"
    ],
    "timeout": "2m"
  },
  "engines": {
    "node": "^24.13.0"
  },
  "prettier": {
    "jsxSingleQuote": false,
    "trailingComma": "all"
  },
  "lint-staged": {
    "**/*": "prettier-standard --format"
  }
}
